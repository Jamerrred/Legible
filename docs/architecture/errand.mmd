flowchart LR
  request["Customer request<br/>+ customer profile"]:::actor --> loop

  subgraph agent["Errand"]
    direction LR
    loop["Orchestrator tool loop<br/>Muse Spark<br/>15 tool calls, 6 minutes"]:::errand

    subgraph gated["Personal-details gate"]
      direction TB
      search["search_web<br/>Exa or saved corpus"]:::tool
      read["read_page<br/>plain fetch, no JavaScript"]:::tool
      browse["browse_task<br/>browser-use and Chromium, 2 workers"]:::tool
    end

    subgraph open["Local tools"]
      direction TB
      math["do_math<br/>totals and dates"]:::tool
      ask["ask_person<br/>approvals"]:::tool
    end

    finish["finish<br/>answer and labelled claims"]:::errand
    evidence{{"Evidence gate"}}:::gate

    loop --> search
    loop --> read
    loop --> browse
    loop --> math
    loop --> ask
    loop --> finish
    finish --> evidence
    evidence -->|"unsupported claim,<br/>up to 2 retries"| loop
  end

  evidence --> report["Report with sources<br/>+ JSONL run log"]:::actor

  classDef actor fill:#FFFFFF,stroke:#33322E,color:#24231F,stroke-width:1.5px
  classDef errand fill:#F1EEFF,stroke:#6A57C7,color:#2C2360,stroke-width:1.5px
  classDef tool fill:#F6F5F1,stroke:#8A877E,color:#33322E
  classDef gate fill:#FFF9E6,stroke:#A87A00,color:#4A3700,stroke-width:1.5px
  style agent fill:#FBFAFF,stroke:#6A57C7,color:#4A3BA0
  style gated fill:#FFF9E6,stroke:#A87A00,color:#4A3700
  style open fill:#FBFAF7,stroke:#8A877E,color:#55524A
