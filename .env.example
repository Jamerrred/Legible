# Copy to .env, which is git-ignored, and fill in. Never commit real keys.
# scripts/start.py creates this file for you and fills in the LEGIBLE_ values.

# Required. The model behind every agent. https://openrouter.ai
OPENROUTER_API_KEY=

# Required. Reads websites and powers the test customers' searches. https://exa.ai
EXA_API_KEY=

# Optional. Lets owners connect accounts such as Google Calendar. https://composio.dev
COMPOSIO_API_KEY=

# Filled in by scripts/start.py and scripts/deploy.py. LEGIBLE_ADMIN_TOKEN is a private password between the app and the public page.
LEGIBLE_ADMIN_TOKEN=
LEGIBLE_EDGE_URL=http://127.0.0.1:8787

# Optional. If you run the app on another machine, list its hostnames here, separated by commas.
LEGIBLE_ALLOWED_HOSTS=
