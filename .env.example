# Copy to .env, which is git-ignored, and fill in. Never commit real keys.

# Required for the consumer agent. https://openrouter.ai
OPENROUTER_API_KEY=

# Required only with --search exa. https://exa.ai
EXA_API_KEY=

# Required for the back office. The Worker holds the same token as the secret ADMIN_TOKEN.
MF_ADMIN_TOKEN=
MF_EDGE_URL=https://musefront.jamerrred-audiobooks.workers.dev

# Optional. Without it, the product runs and accounts just can't be connected. https://composio.dev
COMPOSIO_API_KEY=
