# Copy to .env, which is git-ignored, and fill in. Never commit real keys.
# scripts/start.py creates this file for you and fills in the MF_ values.

# Required. The model behind every agent. https://openrouter.ai
OPENROUTER_API_KEY=

# Required. Reads websites and powers the test customers' searches. https://exa.ai
EXA_API_KEY=

# Optional. Lets owners connect accounts such as Google Calendar. https://composio.dev
COMPOSIO_API_KEY=

# Filled in by scripts/start.py. MF_ADMIN_TOKEN is a private password between the app and the resource.
MF_ADMIN_TOKEN=
MF_EDGE_URL=http://127.0.0.1:8787
